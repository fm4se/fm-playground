VITE_FMP_API_URL=http://localhost:8000/api
VITE_FMP_VERSION=1.5.0
VITE_FMP_UPDATE_SNACKBAR={"visible":"false","severity":"info","message":"No message"}

# Collaborative Editing (optional)
# Set to "true" to enable collaborative editing features
VITE_COLLAB_ENABLED=false
# WebSocket URL for the collaboration server
VITE_COLLAB_WS_URL=ws://localhost:4444

# Error & performance monitoring (optional), reported to GlitchTip.
# Leave empty to disable (recommended for local development).
VITE_GLITCHTIP_DSN=
# Fraction of page loads to record performance data for (0-1). Default: 0.1
# VITE_GLITCHTIP_TRACES_SAMPLE_RATE=0.1
# Environment name shown in GlitchTip. Default: "production" for builds, "development" for `vite dev`.
# VITE_GLITCHTIP_ENVIRONMENT=production
