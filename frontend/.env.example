VITE_FMP_API_URL=http://localhost:8000/api
VITE_FMP_VERSION=1.5.0
VITE_FMP_UPDATE_SNACKBAR={"visible":"false","severity":"info","message":"No message"}

# Collaborative Editing (optional)
# Set to "true" to enable collaborative editing features
VITE_COLLAB_ENABLED=false
# WebSocket URL for the collaboration server
VITE_COLLAB_WS_URL=ws://localhost:4444

# Alloy execution (optional), see frontend/tools/alloy/engine/README.md
# auto = in the browser, server only as fallback | browser | server (previous behaviour)
VITE_ALLOY_EXECUTION_MODE=auto
